# Copia este fichero como .env.local y ajusta la URL de tu API de Express.
# Si REACT_APP_API_URL no está definida, la app usa un servidor simulado
# en memoria (src/services/todo.mock.ts) y funciona sin backend.
#
# La API debe exponer:  GET/POST /todos   y   GET/PATCH/DELETE /todos/:id
REACT_APP_API_URL=http://localhost:4000/api
